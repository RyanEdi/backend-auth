# Railway define PORT automaticamente.
# Nao fixe PORT no painel, a menos que necessario.

NODE_ENV=production

# Banco (Postgres Railway)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Segredos da aplicacao
SESSION_SECRET=troque-por-um-segredo-forte
DATA_SECRET=troque-por-um-segredo-forte
CPF_SECRET=troque-por-um-segredo-forte
EMAIL_SECRET=troque-por-um-segredo-forte
PAYMENT_WEBHOOK_TOKEN=troque-por-um-segredo-forte

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Origem permitida no CORS
FRONTEND_URL=https://direitoeprovento.com.br
